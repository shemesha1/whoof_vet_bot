# ====== Обязательно ======
# Токен от @BotFather
BOT_TOKEN=1234567890:AAAA-замените-на-свой-токен

# Telegram id администраторов через запятую (узнать: отправить боту /id)
ADMIN_IDS=

# ====== Рекомендуется ======
# Чат (или группа) ветеринаров для уведомлений о записях/отменах.
# Добавьте бота в группу, напишите там /id и вставьте chat id (для групп он отрицательный)
VET_CHAT_ID=

# Постоянная ссылка на видеозвонок (Телемост/Zoom/Meet). Если пусто, врач присылает ссылку сам
MEETING_URL=

# Название бренда в текстах и контакт поддержки (@username или телефон)
BRAND_NAME=Whoof
SUPPORT_CONTACT=

# ====== Расписание ======
TIMEZONE=Europe/Moscow
# на сколько дней вперёд показывать запись
DAYS_AHEAD=7
# минимум минут до начала, чтобы можно было записаться
MIN_LEAD_MINUTES=60
# длительность окна по умолчанию, минут
SLOT_MINUTES=30
# сколько дней действует приглашение после покупки
INVITE_TTL_DAYS=90

# ====== База данных ======
# По умолчанию SQLite-файл. Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://whoof:пароль@localhost:5432/whoof
DATABASE_URL=sqlite+aiosqlite:///data/whoof.db

# ====== Вебхук интернет-магазина (необязательно) ======
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# длинная случайная строка, минимум 16 символов (сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))")
WEBHOOK_SECRET=
